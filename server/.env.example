# Copy to server/.env and adjust. Never commit the real .env.

# development | production | test
NODE_ENV=development

# Port the API listens on (the Vite dev server proxies /api here)
PORT=4000

# SQLite database file, relative to the server/ directory. Created on first run.
DATABASE_PATH=./data/orders.db

# Development aid: delay each /api/orders request by a random 0..N ms so responses
# arrive out of order (use it to try the rapid-filter test). 0 disables it.
SIMULATED_LATENCY_MS=0
