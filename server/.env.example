# Copy to server/.env and adjust. Never commit the real .env.

# development | production | test
NODE_ENV=development

# Port the API listens on (the Vite dev server proxies /api here)
PORT=4000

# Secret that signs session tokens: at least 32 random characters, e.g. the output of
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. In development, a random one is generated per run if unset
# (sessions then end whenever the server restarts).
JWT_SECRET=

# How long a login lasts (one working shift by default)
SESSION_TTL_HOURS=8

# SQLite database file, relative to the server/ directory. Created on first run.
DATABASE_PATH=./data/orders.db

# Development aid: delay each /api/orders request by a random 0..N ms so responses
# arrive out of order (use it to try the rapid-filter test). 0 disables it.
SIMULATED_LATENCY_MS=1500
